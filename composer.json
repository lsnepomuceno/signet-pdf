{
    "name": "lsnepomuceno/signet-pdf",
    "description": "Sign and verify PDF signatures in PHP. Each signature is appended as a new revision, so signing again never invalidates the ones before it. PAdES B-B to B-LTA, RFC 3161 timestamps, LTV and ICP-Brasil identity. No framework.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "pdf",
        "pades",
        "pdf-signature",
        "pdf-sign",
        "digital-signature",
        "sign",
        "cades",
        "pkcs7",
        "pkcs12",
        "x509",
        "openssl",
        "timestamp",
        "tsa",
        "rfc3161",
        "ltv",
        "icp-brasil",
        "incremental-update"
    ],
    "authors": [
        {
            "name": "Lucas Nepomuceno",
            "email": "lsn.nepomuceno@gmail.com",
            "homepage": "https://github.com/lsnepomuceno"
        }
    ],
    "homepage": "https://lsnepomuceno.github.io/signet-pdf/",
    "support": {
        "issues": "https://github.com/lsnepomuceno/signet-pdf/issues",
        "source": "https://github.com/lsnepomuceno/signet-pdf",
        "docs": "https://lsnepomuceno.github.io/signet-pdf/",
        "security": "https://github.com/lsnepomuceno/signet-pdf/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=8.4.1 <8.6",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "composer-runtime-api": "^2.2",
        "intervention/image": "^3.11",
        "psr/log": "^3.0",
        "symfony/console": "^8",
        "symfony/http-client": "^8",
        "symfony/http-client-contracts": "^3.6",
        "symfony/process": "^8",
        "symfony/uid": "^8",
        "tecnickcom/tc-lib-pdf-sign": "^2.0"
    },
    "require-dev": {
        "ext-tokenizer": "*",
        "ergebnis/composer-normalize": "^2.52",
        "laravel/pint": "^1.30",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "suggest": {
        "ext-gd": "To use GD library based image processing.",
        "ext-imagick": "To use Imagick based image processing.",
        "lsnepomuceno/laravel-a1-pdf-sign": "A Laravel package sharing this one lineage, being rebuilt on top of it."
    },
    "autoload": {
        "psr-4": {
            "LSNepomuceno\\Signet\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LSNepomuceno\\Signet\\Tests\\": "./tests"
        }
    },
    "bin": [
        "bin/signet"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "ignore"
        },
        "process-timeout": 0
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@lint --test",
            "@analyse",
            "@deps",
            "@normalize --dry-run",
            "@test"
        ],
        "deps": "vendor/bin/composer-dependency-analyser",
        "lint": "vendor/bin/pint",
        "normalize": "composer normalize",
        "samples:build": "php samples/generate.php",
        "test": "vendor/bin/pest --fail-on-skipped",
        "test:cov": "vendor/bin/pest --coverage",
        "test:mutate": ".docker/mutate.sh",
        "test:types": "vendor/bin/pest --type-coverage --min=100"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis.",
        "check": "Run everything the CI runs: style, static analysis and tests.",
        "deps": "Report unused and shadow dependencies.",
        "lint": "Fix code style with Pint (append --test to only check).",
        "normalize": "Sort and format composer.json. CI runs it with --dry-run.",
        "test": "Run the test suite. A skipped test fails it: every check has to run somewhere, and a skip is how one stops.",
        "test:cov": "Run the test suite with line coverage (needs pcov or xdebug).",
        "test:mutate": "Run mutation testing over the certificate, ICP-Brasil, signing, support and validation code. Serial on purpose: --parallel produces no mutations at all in the container. Runs from the package root, because the plugin maps coverage by path and scores 0.00% from anywhere else, and sweeps up afterwards: see .docker/mutate.sh.",
        "test:types": "Report type coverage across src/."
    }
}
