includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    # No baseline: src/ and tests/ are clean at the strictest level. The gate is
    # "no errors", not "no new errors" (docs/spec/quality-policy.md).
    #
    # There is no framework extension in this list, and that absence is the
    # point: nothing here resolves through a container or a facade, so there is
    # no magic for an extension to teach PHPStan about
    # (docs/decisions/0001-the-core-is-framework-agnostic.md).
    level: max

    paths:
        - src
        - tests

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Pest's fluent API (arch(), expect()->and()->not, dataset chains) is
        # runtime magic that PHPStan cannot type without a dedicated extension.
        # These are limits of the tooling, not defects, so they are ignored
        # rather than baselined: a baseline must only track debt that can
        # actually be paid down.
        -
            identifier: method.notFound
            path: tests/*
        -
            identifier: method.nonObject
            path: tests/*
        -
            identifier: property.nonObject
            path: tests/*
        -
            identifier: property.notFound
            path: tests/*
